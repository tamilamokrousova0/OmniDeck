{
  "name": "wa-deck",
  "version": "0.9.5",
  "description": "WA Deck: multi-account WhatsApp manager",
  "main": "src/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:renderer": "esbuild src/renderer/main.entry.js --bundle --outfile=src/renderer/dist/bundle.js --format=iife --target=chrome150 --sourcemap",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron .",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg zip --arm64",
    "dist:win": "npm run build:renderer && electron-builder --win nsis portable --x64",
    "dist:all": "npm run dist:mac && npm run dist:win",
    "dist": "npm run dist:mac && npm run dist:win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.local.wadeck",
    "productName": "WA Deck",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "CHANGELOG.md"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon/icon.icns",
      "extraResources": [
        {
          "from": "build/whisper/mac",
          "to": "whisper"
        }
      ],
      "artifactName": "WA-Deck-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Микрофон нужен для голосовых сообщений и звонков WhatsApp/Telegram.",
        "NSCameraUsageDescription": "Камера нужна для видеозвонков WhatsApp/Telegram."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon/icon.ico",
      "artifactName": "WA-Deck-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/whisper/win",
          "to": "whisper"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WA Deck",
      "uninstallDisplayName": "WA Deck ${version}",
      "installerIcon": "assets/icon/icon.ico",
      "uninstallerIcon": "assets/icon/icon.ico",
      "menuCategory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049"
    },
    "portable": {
      "artifactName": "WA-Deck-${version}-portable-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tamilamokrousova0",
        "repo": "WA-Deck",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamilamokrousova0/WA-Deck.git"
  },
  "homepage": "https://github.com/tamilamokrousova0/WA-Deck",
  "bugs": {
    "url": "https://github.com/tamilamokrousova0/WA-Deck/issues"
  }
}
